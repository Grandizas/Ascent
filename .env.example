# Copy to .env and fill in. Never commit .env.

# Supabase (Project Settings → API). The publishable/anon key is safe for the browser.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Server-only. Never expose to the browser; leave empty unless a server route needs it.
# NUXT_SUPABASE_SECRET_KEY=

# Font Awesome Pro: .npmrc reads FONT_AWESOME_TOKEN from the *shell* environment
# (Windows user env locally, Vercel project env in deploys) at install time;
# npm does not read this file.
# FONT_AWESOME_TOKEN=
